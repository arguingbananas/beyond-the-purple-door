#!/usr/bin/env bash
# Pre-commit: lint, fast tests, and (if installed) a secret scan of what is staged.
# Enable once per clone with: tools/install-hooks.sh     Bypass in an emergency: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
tools/lint.sh
python3 -I -m unittest discover -s tests
node --test tests/*.mjs
if command -v gitleaks >/dev/null 2>&1; then
  # gitleaks 8.19+ calls this "git --staged"; older releases call it "protect --staged"
  gitleaks git --staged --redact --no-banner 2>/dev/null || gitleaks protect --staged --redact --no-banner
else
  echo "note: gitleaks not installed, skipping the secret scan (GitHub secret scanning still applies)"
fi
